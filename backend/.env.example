# Only needed to run the pipeline directly on the HOST (uv run uvicorn app.main:app).
# Under docker compose these values are injected as environment variables instead.

DATABASE_URL="postgresql://atlas:atlas@localhost:5432/atlas"

# Optional LLM enrichment (better summaries + tags). Off unless both are set.
# LLM_ENRICHMENT=true
DEEPSEEK_API_KEY=""

# Optional: also mirror every import into an Obsidian vault (folder of markdown notes).
# OBSIDIAN_VAULT_DIR=/path/to/your/vault

# Optional overrides (compose sets these to a mounted /data volume):
# JOBS_DB_PATH=jobs.db
# UPLOADS_DIR=uploads
# MIN_ENTRY_CHARS=600   # merge sections smaller than this into their page
# MAX_SPLIT_LEVEL=2     # split into notes/entries down to this heading level
