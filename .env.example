# Copy to .env for local development. docker compose reads this file for the
# values below and injects the in-container DATABASE_URL itself.

# Postgres (provisioned by docker compose)
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas

# Host port bindings (change if a port is already in use).
# If you already run a local Postgres on 5432, set POSTGRES_PORT=5433 here AND
# change the DATABASE_URL port below to match.
WEB_PORT=3000
POSTGRES_PORT=5432
IMPORT_SERVICE_PORT=8000

# Used when running the Python backend on the host against the
# dockerized DB. Inside containers, compose overrides this to point at the `db` service.
DATABASE_URL="postgresql://atlas:atlas@localhost:5432/atlas"

# Where the Next.js app finds the Python backend.
ATLAS_API_URL="http://localhost:8000"


# Signs access tokens. Required — generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=""

# Google Cloud project for the agent; credentials come from ADC. Empty disables the agent.
VERTEX_PROJECT=""
# Optional host-only service-account file. Use the gitignored .secrets/vertex.json (absolute path).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/vertex.json
# VERTEX_LOCATION=global
# AGENT_MODEL=gemini-3.8-flash
# AGENT_SEARCH_MODEL=gemini-3.8-flash

# Quality-first agent defaults. These are loop guards, not writing targets.
# AGENT_MAX_CALLS_PER_TURN=12
# AGENT_MAX_CALLS_PER_SESSION=256
# AGENT_MAX_RESEARCH_PER_TURN=3
# AGENT_MAX_RESEARCH_PER_SESSION=48
# AGENT_MAX_REQUEST_BYTES=2000000
# AGENT_TURN_TIMEOUT_SECONDS=300

# Estimated session spending guard, in millionths of USD (5000000 = $5; 0 disables).
# The final in-flight call can exceed it. Unknown cost blocks further session calls.
# AGENT_SESSION_BUDGET_MICROUSD=5000000
